    {"text": "ë",  "kind": "vowel", "height": "mid",  "backness": "central", "frequency": 0.22}
  ],

  // Syllable shapes (C = consonant, V = vowel). Every language has CV; it
  // has each other shape with the given probability.
  "syllables": [
    {"shape": "CV",  "probability": 1.0},
    {"shape": "V",   "probability": 0.45},
    {"shape": "CVC", "probability": 0.55},
    {"shape": "VC",  "probability": 0.25},
    {"shape": "CCV", "probability": 0.2},
    {"shape": "CCVC","probability": 0.1}
  ],

  // Grammar features, picked at random for each new language family with
  // the given weights (roughly the shares in WALS), and occasionally
  // changing later.
  "typology": {
    "word_order":  {"SOV": 45, "SVO": 42, "VSO": 9, "VOS": 3, "OVS": 1},
    "morphology":  {"isolating": 25, "agglutinative": 50, "fusional": 25},
    "tone":        {"none": 58, "simple": 30, "complex": 12}
  },

  // Regular sound changes. When a language undergoes a change, it applies to
  // every word at once (as in real sound laws), so daughter languages show
  // systematic correspondences. Each rule picks the sounds it applies to
  // (`match`), where in the word (`where`), and what happens: shift some
  // features (`to`), "delete", or insert a sound after (`insert_after`).
  //
  //   where: anywhere | word_initial | word_final | between_vowels |
  //          before_front_vowel | before_high_front_vowel | before_consonant |
  //          after_vowel | before_velar
  //
  // `weight` is how often the change is chosen relative to the others.
  "sound_changes": [
    {"name": "intervocalic voicing",   "match": {"manner": "stop", "voiced": false}, "where": "between_vowels", "to": {"voiced": true}, "weight": 3},
    {"name": "intervocalic lenition",  "match": {"manner": "stop", "voiced": true}, "where": "between_vowels", "to": {"manner": "fricative"}, "weight": 2},
    {"name": "final devoicing",        "match": {"manner": ["stop", "affricate", "fricative"], "voiced": true}, "where": "word_final", "to": {"voiced": false}, "weight": 2},
    {"name": "velar palatalization",   "match": {"manner": "stop", "place": "velar"}, "where": "before_front_vowel", "to": {"place": "palatal", "manner": "affricate"}, "weight": 2.5},
    {"name": "assibilation",           "match": {"manner": "stop", "place": "alveolar"}, "where": "before_high_front_vowel", "to": {"manner": "affricate"}, "weight": 1.5},
    {"name": "spirantization",         "match": {"manner": "stop", "voiced": false, "place": ["labial", "alveolar", "velar"]}, "where": "anywhere", "to": {"manner": "fricative"}, "weight": 0.8},
    {"name": "debuccalization of s",   "match": {"manner": "fricative", "place": "alveolar", "voiced": false}, "where": "anywhere", "to": {"place": "glottal"}, "weight": 1},
    {"name": "f becomes h",            "match": {"manner": "fricative", "place": "labial", "voiced": false}, "where": "anywhere", "to": {"place": "glottal"}, "weight": 1},
    {"name": "loss of h",              "match": {"manner": "fricative", "place": "glottal"}, "where": "anywhere", "delete": true, "weight": 1.2},
    {"name": "loss of final stops",    "match": {"manner": "stop"}, "where": "word_final", "delete": true, "weight": 1.5},
    {"name": "loss of final vowels",   "match": {"kind": "vowel"}, "where": "word_final", "delete": true, "weight": 1},
    {"name": "cluster simplification", "match": {"kind": "consonant", "manner": ["stop", "fricative", "affricate"]}, "where": "before_consonant", "delete": true, "weight": 1.5},
    {"name": "final vowel epenthesis", "match": {"kind": "consonant"}, "where": "word_final", "insert_after": "u", "weight": 0.6},
    {"name": "mid vowel raising",      "match": {"kind": "vowel", "height": "mid", "backness": ["front", "back"]}, "where": "anywhere", "to": {"height": "high"}, "weight": 1},
    {"name": "vowel centralization",   "match": {"kind": "vowel", "height": "mid"}, "where": "word_final", "to": {"backness": "central"}, "weight": 0.8},
    {"name": "fronting of u",          "match": {"kind": "vowel", "height": "high", "backness": "back"}, "where": "before_front_vowel", "to": {"backness": "front"}, "weight": 0.5},
    {"name": "w becomes v",            "match": {"manner": "glide", "place": "labial"}, "where": "anywhere", "to": {"manner": "fricative"}, "weight": 1},
    {"name": "y becomes j",            "match": {"manner": "glide", "place": "palatal"}, "where": "word_initial", "to": {"manner": "affricate"}, "weight": 0.8},
    {"name": "rhotacism",              "match": {"manner": "fricative", "place": "alveolar", "voiced": true}, "where": "between_vowels", "to": {"manner": "rhotic"}, "weight": 1},
    {"name": "l becomes r",            "match": {"manner": "lateral"}, "where": "anywhere", "to": {"manner": "rhotic"}, "weight": 0.7},
    {"name": "r becomes l",            "match": {"manner": "rhotic"}, "where": "anywhere", "to": {"manner": "lateral"}, "weight": 0.7},
    {"name": "deaffrication",          "match": {"manner": "affricate"}, "where": "anywhere", "to": {"manner": "fricative"}, "weight": 1},
    {"name": "nasal assimilation",     "match": {"manner": "nasal", "place": "alveolar"}, "where": "before_velar", "to": {"place": "velar"}, "weight": 1},
    {"name": "palatal nasal merger",   "match": {"manner": "nasal", "place": "palatal"}, "where": "anywhere", "to": {"place": "alveolar"}, "weight": 0.6},
    {"name": "glottal stop loss",      "match": {"manner": "stop", "place": "glottal"}, "where": "anywhere", "delete": true, "weight": 0.8},
    {"name": "uvular merger",          "match": {"manner": "stop", "place": "uvular"}, "where": "anywhere", "to": {"place": "velar"}, "weight": 0.8},
    {"name": "fortition of initial w", "match": {"manner": "glide", "place": "labial"}, "where": "word_initial", "to": {"manner": "stop"}, "weight": 0.5}
  ],

  // Core vocabulary: the meanings every language has a word for (a
  // Swadesh-style list). `stability` (0-1) is how resistant the meaning is
  // to being replaced by a new word; numbers and pronouns are the most
  // stable (Pagel et al. 2007). `syllables` is the usual length of a new
  // word. Words for `people`, `land` and `river` are used for names.
  "concepts": [
    {"id": "i",        "stability": 0.95, "syllables": [1, 1]},
