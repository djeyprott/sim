     "demand": {"per_elite": 0.003}},

    {"id": "copper", "name": "Copper", "category": "craft", "weight": 0.2, "spoilage": 0.0, "base_price": 15.0,
     "craft": true, "per_townsperson": 0.01, "per_person": 0.0005, "requires_technique": "copper",
     "inputs": {"copper_ore": 4.0},
     "demand": {"per_farmer": 0.0005, "per_townsperson": 0.003, "per_elite": 0.02}},

    {"id": "bronze", "name": "Bronze", "category": "craft", "weight": 0.2, "spoilage": 0.0, "base_price": 40.0,
